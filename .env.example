# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in your own values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Your Dynatrace environment URL. Copy it from the address bar of your
# Dynatrace environment. Form: https://<tenant-id>.apps.dynatrace.com
DT_ENVIRONMENT=https://YOUR-ENVIRONMENT.apps.dynatrace.com

# Platform token used by the Dynatrace MCP server / dtctl.
# Create it in Dynatrace: Settings -> Platform tokens.
# Grant the MINIMUM scopes needed for the queries this app runs.
DT_PLATFORM_TOKEN=dt0s16.YOUR-PLATFORM-TOKEN
